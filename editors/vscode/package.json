{
  "name": "mastdiff-search",
  "displayName": "mastdiff: Semantic C++ Search",
  "description": "Structural, tree-sitter-powered C++ search inside VS Code — find function definitions, call sites, classes, fields and more with simple fn:/call:/class: queries or raw tree-sitter S-expressions.",
  "version": "0.2.1",
  "publisher": "fedebuonco",
  "repository": {
    "type": "git",
    "url": "https://github.com/fedebuonco/mastdiff"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "c++",
    "cpp",
    "tree-sitter",
    "structural search",
    "semantic search"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mastdiff",
          "title": "mastdiff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mastdiff": [
        {
          "type": "webview",
          "id": "mastdiff.searchView",
          "name": "Semantic C++ Search"
        }
      ]
    },
    "commands": [
      {
        "command": "mastdiff.search",
        "title": "mastdiff: Semantic C++ Search"
      },
      {
        "command": "mastdiff.findCalls",
        "title": "mastdiff: Find Calls to Symbol Under Cursor"
      },
      {
        "command": "mastdiff.findDefinitions",
        "title": "mastdiff: Find Function Definitions of Symbol Under Cursor"
      }
    ],
    "keybindings": [
      {
        "command": "mastdiff.search",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mastdiff.findCalls",
          "when": "editorLangId == cpp",
          "group": "navigation@90"
        },
        {
          "command": "mastdiff.findDefinitions",
          "when": "editorLangId == cpp",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "mastdiff",
      "properties": {
        "mastdiff.binaryPath": {
          "type": "string",
          "default": "mastdiff",
          "description": "Path to the mastdiff binary. Defaults to 'mastdiff' on PATH."
        },
        "mastdiff.include": {
          "type": "string",
          "default": "",
          "description": "Default include globs pre-filled in the search view (e.g. \"src/**,*.hpp\"). Empty = search everything."
        },
        "mastdiff.exclude": {
          "type": "string",
          "default": "",
          "description": "Default exclude globs pre-filled in the search view (e.g. \"tests/**,vendor/**\")."
        },
        "mastdiff.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce in milliseconds before a search fires while typing."
        },
        "mastdiff.maxResults": {
          "type": "number",
          "default": 500,
          "description": "Number of results rendered per page in the results list; the 'Show more' button loads the next page. All results are always fetched."
        },
        "mastdiff.historySize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of previous searches kept in the History tab."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
